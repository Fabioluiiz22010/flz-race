<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linhaRanking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_quadrado"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <TextView
        android:id="@+id/txtPosicao"
        style="@style/FlzRace.FonteDisplay"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textColor="@color/flz_texto_2"
        android:textSize="19sp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFotoRanking"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/flz_ciano_suave"
        android:importantForAccessibility="no"
        android:padding="1dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/FlzRace.FormaCirculo"
        app:strokeColor="@color/flz_ciano_borda"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtNomeRanking"
            style="@style/FlzRace.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtCarroRanking"
            style="@style/FlzRace.TextoSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtValorRanking"
        style="@style/FlzRace.FonteDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/flz_texto"
        android:textSize="16sp" />
</LinearLayout>
