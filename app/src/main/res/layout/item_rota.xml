<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/flz_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal">
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/flz_laranja" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bandeira"
        app:tint="@color/flz_laranja" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="10dp">
        <TextView
            android:id="@+id/txtNomeRota"
            style="@style/FlzRace.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtInfoRota"
            style="@style/FlzRace.TextoSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:src="@drawable/ic_voltar"
        app:tint="@color/flz_texto_2" />
</LinearLayout>
