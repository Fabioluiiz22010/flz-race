<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/FlzRace.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESCOLHA O MODO" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDemo"
            style="@style/FlzRace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:contentPadding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgDemo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_demo"
                    app:tint="@color/flz_roxo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FlzRace.FonteDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="MODO DEMONSTRAÇÃO"
                        android:textColor="@color/flz_texto"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDemoTexto"
                        style="@style/FlzRace.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desligado: medições reais com GPS." />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Modo demonstração" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZero100"
            style="@style/FlzRace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/flz_ciano">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@color/flz_ciano"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_raio"
                    app:tint="@color/flz_fundo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FlzRace.FonteDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 A 100 KM/H"
                        android:textColor="@color/flz_texto"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/FlzRace.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arrancada cronometrada. O acelerômetro detecta a largada." />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLivre"
            style="@style/FlzRace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_quadrado"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_acelerar"
                    app:tint="@color/flz_ciano" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FlzRace.FonteDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VELOCIDADE LIVRE"
                        android:textColor="@color/flz_texto"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/FlzRace.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Velocímetro ao vivo com máxima e média da sessão." />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAB"
            style="@style/FlzRace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/flz_laranja_borda">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_aviso"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_bandeira"
                    app:tint="@color/flz_laranja" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/FlzRace.FonteDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRAJETO A→B"
                        android:textColor="@color/flz_texto"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/FlzRace.TextoSec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Corra numa rota criada pela comunidade ou crie a sua." />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_aviso"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alerta"
                app:tint="@color/flz_laranja" />

            <TextView
                style="@style/FlzRace.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Use apenas em locais fechados ao trânsito."
                android:textColor="@color/flz_laranja"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
